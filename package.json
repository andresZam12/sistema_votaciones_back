{
  "name": "sistema-votaciones-back",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend de preconteo electoral en tiempo real para alta concurrencia",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "loadtest": "tsx loadtest/simulator.ts",
    "loadtest:slow": "tsx loadtest/slow-client.ts",
    "loadtest:jitter": "tsx loadtest/reconnect-jitter.ts",
    "auditor": "tsx loadtest/auditor-client.ts",
    "whoami:check": "tsx scripts/whoami-check.ts",
    "health:check": "tsx scripts/health-check.ts",
    "rebuild:redis": "tsx scripts/rebuild-redis.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.10",
    "ioredis-mock": "^8.13.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
