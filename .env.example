HOST=0.0.0.0
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/votaciones
FANOUT_WINDOW_MS=2000
FANOUT_BATCH=500
MAX_BUFFERED_BYTES=262144
JURADO_KEYS=jurado-key-demo,JUR-88134
AUDITOR_KEYS=auditor-key-demo,AUD-01

# Hostname publico usado por Caddy para emitir el certificado TLS en despliegue (ver docker-compose.prod.yml)
# Ejemplo con sslip.io (no requiere comprar dominio): <IP-con-guiones>.sslip.io
PUBLIC_HOSTNAME=localhost
